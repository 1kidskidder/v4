<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortnite ESP with FOV Circle and Watermark</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
    }
    #fovCircle {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 300px;
      height: 300px;
      border: 5px solid blue;
      border-radius: 50%;
      pointer-events: none;
      transform: translate(-50%, -50%);
    }
    #watermark {
      position: absolute;
      top: 10px;
      left: 10px;
      color: white;
      font-family: Arial, sans-serif;
      font-size: 20px;
      z-index: 10;
    }
    .espBox {
      position: absolute;
      border: 2px solid red;
      border-radius: 5px;
      z-index: 5;
    }
  </style>
</head>
<body>
  <div id="fovCircle"></div>
  <div id="watermark">Juice.cc made by Adrian</div>

  <script>
    const socket = new WebSocket('ws://localhost:8080');

    socket.onmessage = function(event) {
      const data = JSON.parse(event.data);
      drawESP(data.x, data.y);
    };

    function drawESP(x, y) {
      const espBox = document.createElement('div');
      espBox.classList.add('espBox');
      espBox.style.width = '50px';
      espBox.style.height = '50px';
      espBox.style.left = `${x - 25}px`;
      espBox.style.top = `${y - 25}px`;
      document.body.appendChild(espBox);

      setTimeout(() => {
        espBox.remove();
      }, 1000);
    }

    function drawFovCircle() {
      const fovCircle = document.getElementById('fovCircle');
      const circleSize = 300;  
      fovCircle.style.width = `${circleSize}px`;
      fovCircle.style.height = `${circleSize}px`;
    }

    drawFovCircle();
  </script>
</body>
</html>
