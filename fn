<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fortnite ESP with FOV Circle and Watermark</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
    }

    /* FOV Circle Styling */
    #fovCircle {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 250px;
      height: 250px;
      border: 3px solid blue; /* Thin outline for the FOV circle */
      border-radius: 50%;
      pointer-events: none;
      transform: translate(-50%, -50%);
    }

    /* Watermark Styling */
    #watermark {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      background-color: rgba(0, 0, 0, 0.7);
      padding: 10px 20px;
      border-radius: 5px;
      color: white;
      font-family: Arial, sans-serif;
      font-weight: bold;
      font-size: 18px;
      text-shadow: 2px 2px 5px black;
      z-index: 10;
      display: flex;
      justify-content: center;
      align-items: center;
      max-width: 100%;
      box-sizing: border-box;
      border: 2px solid white;  /* Rectangle background border */
    }

    /* Ping display inside the watermark */
    #ping {
      font-size: 16px;
      font-weight: normal;
    }

    /* ESP Text for emoji */
    .espText {
      position: absolute;
      z-index: 5;
      color: red;
      font-size: 30px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div id="fovCircle"></div>
  <div id="watermark">
    Juice.cc made by Adrian <span id="ping">Ping: 60</span>
  </div>

  <script>
    const socket = new WebSocket('ws://localhost:8080');  // Connect to WebSocket server

    socket.onmessage = function(event) {
      const data = JSON.parse(event.data);
      drawESP(data.x, data.y, data.isEnemy);  // Draw ESP based on data received from Frida
    };

    function drawESP(x, y, isEnemy) {
      // Add the "👻" emoji above the player’s head (both enemy and your own)
      const espText = document.createElement('div');
      espText.classList.add('espText');
      espText.innerText = '👻';  // Emoji for ESP
      espText.style.left = `${x - 15}px`;  // Center emoji horizontally
      espText.style.top = `${y - 50}px`;  // Position it above the player's head
      document.body.appendChild(espText);

      // Optional: Remove ESP after a delay
      setTimeout(() => {
        espText.remove();
      }, 1000);
    }

    // FOV Circle Logic (already implemented)
    function drawFovCircle() {
      const fovCircle = document.getElementById('fovCircle');
      const circleSize = 250;  // Circle radius in pixels (made thinner)
      fovCircle.style.width = `${circleSize}px`;
      fovCircle.style.height = `${circleSize}px`;
    }

    // Call the function to draw FOV circle
    drawFovCircle();
  </script>
</body>
</html>
